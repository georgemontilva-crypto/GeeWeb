# ── Obligatorias ─────────────────────────────────────────────
# En Railway: referencia la variable del servicio MySQL → ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://root:password@localhost:3306/geeweb
# Cadena larga y aleatoria para firmar las sesiones del panel
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Primer usuario administrador (se crea solo en el primer arranque)
ADMIN_EMAIL=admin@tutienda.com
ADMIN_PASSWORD=cambia-esta-clave

# ── Opcionales ───────────────────────────────────────────────
# URL pública del sitio (para los enlaces de los correos)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Cloudflare R2 para las imágenes. Si se dejan vacías, las imágenes
# se guardan en la base de datos (funciona, pero R2 es lo recomendado).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Resend para los correos de pedido. Si se deja vacío no se envían correos.
RESEND_API_KEY=
EMAIL_FROM=Tienda <pedidos@tudominio.com>

# Pon "false" para arrancar sin productos de ejemplo
SEED_DEMO=true
