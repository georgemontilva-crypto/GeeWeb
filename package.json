{
  "name": "geeweb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "superjson": "^2.2.6",
    "wouter": "^3.13.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
